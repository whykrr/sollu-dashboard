    "item": [
        {
            "name": "System & Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{apiBaseUrl}}/health",
                            "host": [
                                "{{apiBaseUrl}}"
                            ],
                            "path": [
                                "health"
                            ]
                        },
                        "description": "Cek status kesehatan sistem (Database, Cache/Redis, Storage)."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Device Pairing & Connection",
            "item": [
                {
                    "name": "Connect Device",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.token) {",
                                    "    pm.collectionVariables.set('deviceToken', jsonData.data.token);",
                                    "    console.log('deviceToken updated:', jsonData.data.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"otp\": \"12345678\",\n    \"device_uuid\": \"{{deviceUuid}}\",\n    \"hardware_fingerprint\": \"{{hardwareSignature}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/device/connect",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "device",
                                "connect"
                            ]
                        },
                        "description": "Koneksi perangkat menggunakan OTP dan Hardware Fingerprint."
                    },
                    "response": []
                },
                {
                    "name": "Check Device Status",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{deviceToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "X-DEVICE-UUID",
                                "value": "{{deviceUuid}}"
                            },
                            {
                                "key": "X-HARDWARE-SIGNATURE",
                                "value": "{{hardwareSignature}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/device/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "device",
                                "status"
                            ]
                        },
                        "description": "Cek apakah token dan fingerprint masih valid/aktif."
                    },
                    "response": []
                }
            ]
        },
